// ============================================================
// ClassFlow — Prisma Schema
// Multi-tenant School Management SaaS
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1. PLATFORM & SCHOOL
// ============================================================

model School {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  address             String?
  phone               String?
  email               String?
  logo                String?
  activeResultReportTemplateId String?
  resultReportTitle   String?  @default("كشف نتائج القسم")
  resultReportSubtitle String?
  resultReportFooterNote String?
  resultReportNotesLabel String @default("ملاحظات الإدارة")
  resultReportSignatureLabel String @default("الختم والتوقيع")
  resultReportClassroomLabel String @default("القسم")
  resultReportTermLabel String @default("الفصل")
  resultReportStatsLabel String @default("إحصاءات")
  resultReportStudentsCountLabel String @default("عدد التلاميذ")
  resultReportClassAverageLabel String @default("معدل القسم")
  resultReportShowRank Boolean @default(true)
  resultReportShowWeightedScore Boolean @default(true)
  resultReportShowRuleNotes Boolean @default(true)
  resultReportShowPolicyNote Boolean @default(true)
  resultReportShowSubjectCoefficient Boolean @default(true)
  resultReportShowSchoolContacts Boolean @default(true)
  resultReportShowNotesSection Boolean @default(true)
  resultReportShowSignatureSection Boolean @default(true)
  subscriptionStatus  String   @default("TRIAL")
  billingStudentCount Int      @default(0)
  testWeight          Float    @default(0.5)
  examWeight          Float    @default(0.5)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users              User[]
  educationStages    EducationStage[]
  academicYears      AcademicYear[]
  levels             Level[]
  streams            Stream[]
  classrooms         Classroom[]
  subjects           Subject[]
  students           Student[]
  teachers           Teacher[]
  parents            Parent[]
  fees               Fee[]
  studentFees        StudentFee[]
  invoices           Invoice[]
  payments           Payment[]
  schedules          Schedule[]
  lessons            Lesson[]
  attendances        Attendance[]
  grades             Grade[]
  assessments        Assessment[]
  assessmentScores   AssessmentScore[]
  resultRules        ResultRule[]
  resultAuditLogs    ResultAuditLog[]
  resultPublications ResultPublication[]
  resultReportTemplates ResultReportTemplate[] @relation("SchoolResultReportTemplates")
  activeResultReportTemplate ResultReportTemplate? @relation("SchoolActiveResultReportTemplate", fields: [activeResultReportTemplateId], references: [id])
  teacherAttendances TeacherAttendance[]
  scheduleAttendances ScheduleAttendance[]
  teachingHourEntries TeachingHourEntry[]
  notifications      Notification[]
  notificationTemplates NotificationTemplate[]
  notificationCampaigns NotificationCampaign[]
  notificationRecipients NotificationRecipient[]
}

model ResultReportTemplate {
  id                      String   @id @default(cuid())
  schoolId                String
  school                  School   @relation("SchoolResultReportTemplates", fields: [schoolId], references: [id])
  activeForSchools        School[] @relation("SchoolActiveResultReportTemplate")
  name                    String
  sourceType              String   @default("SYSTEM")
  sourceFileName          String?
  sourceDescription       String?
  sourcePreview           String?
  definitionVersion       Int      @default(1)
  isActive                Boolean  @default(false)
  title                   String   @default("كشف نتائج القسم")
  subtitle                String?
  footerNote              String?
  notesLabel              String   @default("ملاحظات الإدارة")
  signatureLabel          String   @default("الختم والتوقيع")
  classroomLabel          String   @default("القسم")
  termLabel               String   @default("الفصل")
  statsLabel              String   @default("إحصاءات")
  studentsCountLabel      String   @default("عدد التلاميذ")
  classAverageLabel       String   @default("معدل القسم")
  showRank                Boolean  @default(true)
  showWeightedScore       Boolean  @default(true)
  showRuleNotes           Boolean  @default(true)
  showPolicyNote          Boolean  @default(true)
  showSubjectCoefficient  Boolean  @default(true)
  showSchoolContacts      Boolean  @default(true)
  showNotesSection        Boolean  @default(true)
  showSignatureSection    Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([schoolId, isActive])
  @@index([schoolId, updatedAt])
}

// ============================================================
// 2. ACADEMIC STRUCTURE
// ============================================================

model EducationStage {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  levels Level[]

  @@index([schoolId])
}

model Level {
  id        String         @id @default(cuid())
  schoolId  String
  school    School         @relation(fields: [schoolId], references: [id])
  stageId   String
  stage     EducationStage @relation(fields: [stageId], references: [id])
  name      String
  order     Int            @default(0)
  createdAt DateTime       @default(now())

  classrooms          Classroom[]
  streams             Stream[]
  subjectCoefficients SubjectCoefficient[]

  @@index([schoolId, stageId])
}

model Stream {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  levelId   String
  level     Level    @relation(fields: [levelId], references: [id])
  name      String
  code      String?
  createdAt DateTime @default(now())

  classrooms          Classroom[]
  subjectCoefficients SubjectCoefficient[]

  @@index([schoolId, levelId])
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  name      String
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  terms              Term[]
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
  attendances        Attendance[]
  lessons            Lesson[]
  grades             Grade[]
  assessments        Assessment[]
  resultPublications ResultPublication[]

  @@index([schoolId])
}

model Term {
  id             String       @id @default(cuid())
  schoolId       String
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  name           String
  startsAt       DateTime
  endsAt         DateTime
  order          Int          @default(1)
  isActive       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  attendances        Attendance[]
  lessons            Lesson[]
  grades             Grade[]
  assessments        Assessment[]
  resultPublications ResultPublication[]

  @@index([schoolId, academicYearId])
}

// ============================================================
// 3. CLASSROOM & SUBJECT
// ============================================================

model Classroom {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  levelId   String
  level     Level    @relation(fields: [levelId], references: [id])
  streamId  String?
  stream    Stream?  @relation(fields: [streamId], references: [id])
  name      String
  capacity  Int      @default(40)
  createdAt DateTime @default(now())

  enrollments         Enrollment[]
  teacherAssignments  TeacherAssignment[]
  lessons             Lesson[]
  subjectCoefficients SubjectCoefficient[]
  studentFees         StudentFee[]
  invoices            Invoice[]
  attendances         Attendance[]
  grades              Grade[]
  assessments         Assessment[]
  resultPublications  ResultPublication[]
  schedules           Schedule[]

  @@index([schoolId, levelId])
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  nameAr    String
  nameFr    String?
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  teacherAssignments  TeacherAssignment[]
  subjectCoefficients SubjectCoefficient[]
  grades              Grade[]
  assessments         Assessment[]
  lessons             Lesson[]
  attendances         Attendance[]
  schedules           Schedule[]
}

model SubjectCoefficient {
  id             String     @id @default(cuid())
  schoolId       String
  academicYearId String
  levelId        String
  level          Level      @relation(fields: [levelId], references: [id])
  streamId       String?
  stream         Stream?    @relation(fields: [streamId], references: [id])
  classroomId    String?
  classroom      Classroom? @relation(fields: [classroomId], references: [id])
  subjectId      String
  subject        Subject    @relation(fields: [subjectId], references: [id])
  coefficient    Float      @default(1)
  createdAt      DateTime   @default(now())

  @@index([schoolId, levelId])
  @@index([schoolId, classroomId])
  @@index([academicYearId, subjectId, classroomId])
}

// ============================================================
// 4. PEOPLE
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  role          String    @default("TEACHER")
  schoolId      String?
  school        School?   @relation(fields: [schoolId], references: [id])
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  teacher            Teacher?
  parent             Parent?
  notifications      Notification[]
  createdNotificationTemplates NotificationTemplate[] @relation("NotificationTemplateCreatedBy")
  createdNotificationCampaigns NotificationCampaign[] @relation("NotificationCampaignCreatedBy")
  approvedNotificationCampaigns NotificationCampaign[] @relation("NotificationCampaignApprovedBy")
  cancelledNotificationCampaigns NotificationCampaign[] @relation("NotificationCampaignCancelledBy")
  notificationRecipients NotificationRecipient[]
  attendanceLogs     TeacherAttendance[]
  confirmedScheduleAttendances ScheduleAttendance[] @relation("ScheduleAttendanceConfirmer")
  recordedTeachingHourEntries TeachingHourEntry[] @relation("TeachingHourEntryRecorder")
  createdResultRules ResultRule[]        @relation("ResultRuleCreatedBy")
  updatedResultRules ResultRule[]        @relation("ResultRuleUpdatedBy")
  resultAuditLogs    ResultAuditLog[]    @relation("ResultAuditActor")
  userPermissions    UserPermission[]
}

model Teacher {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  phone     String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  teacherAssignments TeacherAssignment[]
  lessons            Lesson[]
  grades             Grade[]
  assessments        Assessment[]
  attendanceLogs     TeacherAttendance[]
  attendances        Attendance[]
  schedules          Schedule[]
}

model Parent {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  schoolId          String
  school            School   @relation(fields: [schoolId], references: [id])
  phone             String?
  preferredLanguage String   @default("ar")
  createdAt         DateTime @default(now())

  studentParents StudentParent[]
  notificationRecipients NotificationRecipient[]
}

model Student {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id])
  firstName     String
  lastName      String
  gender        String?
  birthDate     DateTime?
  studentNumber String?
  address       String?
  phone         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  enrollments      Enrollment[]
  studentParents   StudentParent[]
  studentFees      StudentFee[]
  invoices         Invoice[]
  attendances      Attendance[]
  grades           Grade[]
  assessmentScores AssessmentScore[]
  payments         Payment[]
  notificationRecipients NotificationRecipient[]
}

model StudentParent {
  id                   String   @id @default(cuid())
  schoolId             String
  studentId            String
  student              Student  @relation(fields: [studentId], references: [id])
  parentId             String
  parent               Parent   @relation(fields: [parentId], references: [id])
  relationship         String?
  isPrimary            Boolean  @default(false)
  receiveNotifications Boolean  @default(true)
  createdAt            DateTime @default(now())

  @@unique([studentId, parentId])
  @@index([schoolId])
}

model Enrollment {
  id             String       @id @default(cuid())
  schoolId       String
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  classroomId    String
  classroom      Classroom    @relation(fields: [classroomId], references: [id])
  status         String       @default("ACTIVE")
  enrolledAt     DateTime     @default(now())

  @@unique([studentId, academicYearId])
  @@index([schoolId, academicYearId])
}

model TeacherAssignment {
  id             String       @id @default(cuid())
  schoolId       String
  teacherId      String
  teacher        Teacher      @relation(fields: [teacherId], references: [id])
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id])
  classroomId    String
  classroom      Classroom    @relation(fields: [classroomId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  hourlyRate     Float?
  weeklyHours    Float?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  teachingHourEntries TeachingHourEntry[]

  @@unique([teacherId, subjectId, classroomId, academicYearId])
  @@index([schoolId, academicYearId])
}

// ============================================================
// 5. DAILY REGISTERS
// ============================================================

model Attendance {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  termId         String?
  term           Term?        @relation(fields: [termId], references: [id])
  date           DateTime     @default(now())
  status         String       @default("PRESENT")
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  classroomId    String
  classroom      Classroom    @relation(fields: [classroomId], references: [id])
  subjectId      String?
  subject        Subject?     @relation(fields: [subjectId], references: [id])
  scheduleId     String?
  schedule       Schedule?     @relation(fields: [scheduleId], references: [id])
  teacherId      String
  teacher        Teacher      @relation(fields: [teacherId], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([studentId, date, scheduleId])
  @@index([studentId, date, subjectId])
  @@index([schoolId, date])
  @@index([schoolId, scheduleId, date])
}

model Lesson {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  termId         String?
  term           Term?        @relation(fields: [termId], references: [id])
  title          String
  description    String?
  duration       Int?
  homework       String?
  notes          String?
  status         String       @default("DRAFT")
  date           DateTime     @default(now())
  classroomId    String
  classroom      Classroom    @relation(fields: [classroomId], references: [id])
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id])
  scheduleId     String?
  schedule       Schedule?     @relation(fields: [scheduleId], references: [id])
  teacherId      String
  teacher        Teacher      @relation(fields: [teacherId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([schoolId, academicYearId])
  @@index([schoolId, scheduleId, date])
}

model Grade {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  termId         String
  term           Term         @relation(fields: [termId], references: [id])
  assessmentType String
  label          String
  score          Float
  maxScore       Float        @default(20)
  status         String       @default("DRAFT")
  date           DateTime     @default(now())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id])
  classroomId    String
  classroom      Classroom    @relation(fields: [classroomId], references: [id])
  teacherId      String
  teacher        Teacher      @relation(fields: [teacherId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([schoolId, academicYearId, termId])
}

model Assessment {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  termId         String
  term           Term         @relation(fields: [termId], references: [id])
  classroomId    String
  classroom      Classroom    @relation(fields: [classroomId], references: [id])
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id])
  teacherId      String
  teacher        Teacher      @relation(fields: [teacherId], references: [id])
  type           String
  title          String
  maxScore       Float        @default(20)
  status         String       @default("DRAFT")
  date           DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  scores AssessmentScore[]

  @@index([schoolId, academicYearId, termId])
  @@index([classroomId, subjectId, termId])
}

model AssessmentScore {
  id           String     @id @default(cuid())
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id])
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id])
  score        Float
  status       String     @default("DRAFT")
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, studentId])
  @@index([schoolId, studentId])
}

model ResultPublication {
  id               String       @id @default(cuid())
  schoolId         String
  school           School       @relation(fields: [schoolId], references: [id])
  academicYearId   String
  academicYear     AcademicYear @relation(fields: [academicYearId], references: [id])
  termId           String
  term             Term         @relation(fields: [termId], references: [id])
  classroomId      String
  classroom        Classroom    @relation(fields: [classroomId], references: [id])
  status           String       @default("OPEN")
  approvedAt       DateTime?
  lockedAt         DateTime?
  approvedByUserId String?
  lockedByUserId   String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([academicYearId, termId, classroomId])
  @@index([schoolId, termId, classroomId])
}

model ResultRule {
  id              String    @id @default(cuid())
  schoolId        String
  school          School    @relation(fields: [schoolId], references: [id])
  name            String
  term1TestWeight Float     @default(3)
  term1ExamWeight Float     @default(1)
  term1Denominator Float    @default(4)
  term1RequireTest Boolean  @default(true)
  term1RequireExam Boolean  @default(true)
  term2TestWeight Float     @default(3)
  term2ExamWeight Float     @default(2)
  term2Denominator Float    @default(5)
  term2RequireTest Boolean  @default(true)
  term2RequireExam Boolean  @default(true)
  term3TestWeight Float     @default(3)
  term3ExamWeight Float     @default(3)
  term3Denominator Float    @default(6)
  term3RequireTest Boolean  @default(true)
  term3RequireExam Boolean  @default(true)
  testWeight      Float     @default(3)
  exam1Weight     Float     @default(1)
  exam2Weight     Float     @default(2)
  exam3Weight     Float     @default(3)
  denominator     Float     @default(9)
  requireTest     Boolean   @default(true)
  requireExam1    Boolean   @default(true)
  requireExam2    Boolean   @default(true)
  requireExam3    Boolean   @default(true)
  status          String    @default("PUBLISHED")
  version         Int       @default(1)
  notes           String?
  publishedAt     DateTime?
  createdByUserId String?
  createdByUser   User?     @relation("ResultRuleCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedByUser   User?     @relation("ResultRuleUpdatedBy", fields: [updatedByUserId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([schoolId, status])
  @@index([schoolId, version])
}

model ResultAuditLog {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  actorUserId String?
  actorUser   User?    @relation("ResultAuditActor", fields: [actorUserId], references: [id])
  entityType  String
  entityId    String?
  action      String
  description String?
  beforeJson  String?
  afterJson   String?
  createdAt   DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([entityType, entityId])
}

// ============================================================
// 6. FINANCE
// ============================================================

model Fee {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  name        String
  amount      Float
  frequency   String   @default("MONTHLY")
  levelId     String?
  classroomId String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  studentFees StudentFee[]
  invoices    Invoice[]
  payments    Payment[]
}

model StudentFee {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id])
  feeId       String
  fee         Fee       @relation(fields: [feeId], references: [id])
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  invoices Invoice[]

  @@unique([studentId, feeId])
  @@index([schoolId])
}

model Invoice {
  id           String     @id @default(cuid())
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id])
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id])
  feeId        String
  fee          Fee        @relation(fields: [feeId], references: [id])
  studentFeeId String
  studentFee   StudentFee @relation(fields: [studentFeeId], references: [id])
  classroomId  String
  classroom    Classroom  @relation(fields: [classroomId], references: [id])
  month        String
  amount       Float
  status       String     @default("PENDING")
  dueDate      DateTime?
  createdAt    DateTime   @default(now())

  payments Payment[]

  @@unique([studentFeeId, month])
  @@index([schoolId, month])
}

model Payment {
  id               String   @id @default(cuid())
  schoolId         String
  school           School   @relation(fields: [schoolId], references: [id])
  amount           Float
  date             DateTime @default(now())
  method           String   @default("CASH")
  receiptNumber    String?
  notes            String?
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id])
  feeId            String?
  fee              Fee?     @relation(fields: [feeId], references: [id])
  invoiceId        String?
  invoice          Invoice? @relation(fields: [invoiceId], references: [id])
  receivedByUserId String?
  createdAt        DateTime @default(now())

  @@index([schoolId, date])
}

// ============================================================
// 7. ATTENDANCE & NOTIFICATIONS & SCHEDULE
// ============================================================

model TeacherAttendance {
  id        String    @id @default(cuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id])
  date      DateTime  @default(now())
  checkIn   DateTime?
  checkOut  DateTime?
  status    String    @default("PRESENT")
  teacherId String
  teacher   Teacher   @relation(fields: [teacherId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])

  @@unique([teacherId, date])
}

model TeachingHourEntry {
  id                  String            @id @default(cuid())
  schoolId            String
  school              School            @relation(fields: [schoolId], references: [id])
  teacherAssignmentId String
  teacherAssignment   TeacherAssignment @relation(fields: [teacherAssignmentId], references: [id])
  date                DateTime
  hoursTaught         Float             @default(0)
  notes               String?
  recordedByUserId    String
  recordedByUser      User              @relation("TeachingHourEntryRecorder", fields: [recordedByUserId], references: [id])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([teacherAssignmentId, date])
  @@index([schoolId, date])
}

model Notification {
  id           String    @id @default(cuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id])
  title        String
  message      String
  type         String
  entityType   String?
  entityId     String?
  actionUrl    String?
  metadata     String?
  channel      String    @default("IN_APP")
  status       String    @default("PENDING")
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  read         Boolean   @default(false)
  sentAt       DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())

  @@index([schoolId, userId, read])
  @@index([schoolId, type, status])
  @@index([schoolId, entityType, entityId])
}

model NotificationTemplate {
  id                 String   @id @default(cuid())
  schoolId           String
  school             School   @relation(fields: [schoolId], references: [id])
  name               String
  type               String
  channel            String   @default("WHATSAPP")
  titleTemplate      String
  messageTemplate    String
  requiresApproval   Boolean  @default(true)
  isSystem           Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdByUserId    String?
  createdByUser      User?    @relation("NotificationTemplateCreatedBy", fields: [createdByUserId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  campaigns          NotificationCampaign[]

  @@index([schoolId, type, isActive])
  @@index([schoolId, updatedAt])
}

model NotificationCampaign {
  id                 String   @id @default(cuid())
  schoolId           String
  school             School   @relation(fields: [schoolId], references: [id])
  templateId         String?
  template           NotificationTemplate? @relation(fields: [templateId], references: [id])
  type               String
  channel            String   @default("WHATSAPP")
  status             String   @default("DRAFT")
  title              String
  message            String
  audienceType       String
  audienceFilters    String?
  exclusionFilters   String?
  recipientsCount    Int      @default(0)
  createdByUserId    String
  createdByUser      User     @relation("NotificationCampaignCreatedBy", fields: [createdByUserId], references: [id])
  approvedByUserId   String?
  approvedByUser     User?    @relation("NotificationCampaignApprovedBy", fields: [approvedByUserId], references: [id])
  cancelledByUserId  String?
  cancelledByUser    User?    @relation("NotificationCampaignCancelledBy", fields: [cancelledByUserId], references: [id])
  scheduledFor       DateTime?
  submittedAt        DateTime?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  rejectedReason     String?
  cancelledAt        DateTime?
  sentAt             DateTime?
  completedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  recipients         NotificationRecipient[]

  @@index([schoolId, status, createdAt])
  @@index([schoolId, type, createdAt])
}

model NotificationRecipient {
  id                 String   @id @default(cuid())
  schoolId           String
  school             School   @relation(fields: [schoolId], references: [id])
  campaignId         String
  campaign           NotificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?    @relation(fields: [userId], references: [id])
  parentId           String?
  parent             Parent?  @relation(fields: [parentId], references: [id])
  studentId          String?
  student            Student? @relation(fields: [studentId], references: [id])
  phone              String?
  channel            String   @default("WHATSAPP")
  status             String   @default("PENDING")
  messageOverride    String?
  sentAt             DateTime?
  deliveredAt        DateTime?
  failedAt           DateTime?
  providerMessageId  String?
  errorMessage       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([schoolId, campaignId, status])
  @@index([schoolId, userId])
  @@index([schoolId, studentId])
}

model Schedule {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  dayOfWeek   Int
  startTime   String
  endTime     String
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id])
  teacherId   String?
  teacher     Teacher?  @relation(fields: [teacherId], references: [id])
  createdAt   DateTime  @default(now())
  studentAttendances Attendance[]
  lessons Lesson[]
  attendances ScheduleAttendance[]

  @@index([schoolId, classroomId])
  @@index([teacherId])
}

model ScheduleAttendance {
  id                String   @id @default(cuid())
  schoolId          String
  school            School   @relation(fields: [schoolId], references: [id])
  scheduleId        String
  schedule          Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  date              DateTime
  status            String   @default("PRESENT")
  notes             String?
  confirmedByUserId String
  confirmedByUser   User     @relation("ScheduleAttendanceConfirmer", fields: [confirmedByUserId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([scheduleId, date])
  @@index([schoolId, date, status])
  @@index([schoolId, confirmedByUserId])
}

// ============================================================
// 8. PERMISSIONS
// ============================================================

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String?
  description String?
  category    String?
  createdAt   DateTime @default(now())

  userPermissions UserPermission[]
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  grantedBy    String?
  createdAt    DateTime   @default(now())

  @@unique([userId, permissionId])
  @@index([userId])
}
